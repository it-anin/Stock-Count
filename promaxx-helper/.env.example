# แม่แบบค่าตั้งของ PromaxxHelper (ตัวช่วยของปุ่ม "บันทึกลง PROMAXX" ในหน้า 📦 ปรับปรุงสินค้า)
# คัดลอกเป็นไฟล์ชื่อ .env แล้ววางข้าง PromaxxHelper.exe (หรือข้าง promaxx_helper.py ถ้ารันจากซอร์ส) แล้วเติมค่า
# ⛔ ไฟล์ .env ห้ามเข้า git เด็ดขาด — repo Stock-Count เป็น PUBLIC (อยู่ใน .gitignore แล้ว) · หน้าเว็บไม่เคยเห็นหรือส่งรหัสนี้

# บัญชี ProMaxx ที่ตัวช่วยใช้ล็อกอิน — เอกสารที่ทำใน ProMaxx จะลงชื่อบัญชีนี้ (ใช้ชื่อตัวแปรเดียวกับบอท auto-r01)
PROMAXX_USERNAME=
PROMAXX_PASSWORD=

# ใส่เฉพาะเมื่อ ssmaxx.exe ไม่ได้อยู่ที่ C:\SeniorSoft ProMaxx\ssmaxx.exe
# ตัวช่วยจะเปิด ProMaxx.exe ในโฟลเดอร์เดียวกับไฟล์นี้ (ตัวเปิดโปรแกรมที่ทางลัดของพนักงานใช้) — เปิด ssmaxx.exe ตรงๆ แล้ว ProMaxx แจ้ง
# "Application to the program is open to change." และไม่ไปหน้า Login · ถ้าชี้ไปที่ ProMaxx.exe เองก็เปิดไฟล์นั้นตามที่ตั้ง
# PROMAXX_EXE_PATH=

# 1 = เปิดไฟล์ที่ตั้งไว้ตรงๆ ไม่สลับเป็น ProMaxx.exe (ใช้ตอนตรวจปัญหาเท่านั้น)
# PROMAXX_LAUNCH_DIRECT=

# argument ที่ shortcut ของพนักงานส่งให้โปรแกรมที่เปิด (ถ้ามี — ดูช่อง Target ใน Properties ของ shortcut "ProMaxx") · ทางลัดปกติไม่มี argument
# PROMAXX_EXE_ARGS=

# พอร์ตที่ตัวช่วยฟัง (ค่าเริ่มต้น 47831) — ต้องตรงกับ PROMAXX_HELPER_URL ใน index.html
# HELPER_PORT=47831

# เว็บเพิ่มเติมที่อนุญาตให้สั่งตัวช่วย (คั่นด้วย ,) — ปกติไม่ต้องใส่ (https://anin-stock-count.vercel.app อนุญาตอยู่แล้ว)
# ใช้ตอนทดสอบกับ Vercel preview หรือเปิดหน้าเว็บจากเครื่องตัวเอง เช่น http://localhost:8080 (ห้ามใส่ * และห้ามมี path)
# HELPER_ALLOWED_ORIGINS=

# ชื่อโปรเซสของบอทที่ใช้เมาส์/คีย์บอร์ดจริงและห้ามขับ ProMaxx ซ้อนกัน (คั่นด้วย ,) — ค่าเริ่มต้น seniorsoftexport.exe,autor01export.exe
# HELPER_BLOCK_PROCS=

# ชื่อโปรเซสของ ProMaxx (ค่าเริ่มต้น ssmaxx.exe)
# SSMAXX_PROC_NAME=

# ── รุ่น 2026-11-04.5 ── ทั้งสองค่าเปิดเป็นค่าเริ่มต้น (ไม่ต้องใส่) · ใส่ 0 / false / no / off เพื่อปิด (ไม่ต้อง build exe ใหม่ แค่ปิด-เปิดตัวช่วย)
# ใช้ ProMaxx ที่เปิด/ล็อกอินค้างอยู่ต่อ — เฉพาะเมื่อไม่มีฟอร์มเอกสาร/กล่อง/หน้าต่างอื่นค้าง (มีฟอร์มค้าง = ตัวช่วยปฏิเสธ ไม่แตะงานของพนักงาน)
# ปิด = ProMaxx เปิดอยู่แล้วปฏิเสธทุกกรณี (ALREADY_RUNNING) เหมือนรุ่นก่อน
# PROMAXX_ATTACH_EXISTING=1

# ซ่อนหน้าต่าง ProMaxx หลังล็อกอิน แล้วสั่งเมนู/ปุ่มผ่านโครงสร้างภายใน (ไม่ใช้เมาส์/คีย์บอร์ด) จนถึงปุ่ม "นำเข้าไฟล์เอกสาร" แล้วแสดงกลับ
# (ช่วงล็อกอินยังเห็นหน้าต่างและต้องไม่แตะเมาส์/คีย์บอร์ด ~15–20 วินาที) · ปิด = ใช้เมาส์จริงทุกขั้นเหมือนรุ่นก่อน
# PROMAXX_HIDE_AFTER_LOGIN=1
